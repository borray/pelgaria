# ── Среда выполнения ───────────────────────────────────────────────
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Базовый адрес фронтенда (CORS, ссылки в OAuth/редиректах). Без хардкода прод-URL.
CLIENT_URL=http://localhost:5173

# ── База данных (PostgreSQL) ───────────────────────────────────────
DATABASE_URL="postgresql://sonar:password@localhost:5432/sonar?schema=public"

# ── JWT / сессии ───────────────────────────────────────────────────
# В production обязательно замените на длинные случайные значения (32+ байт).
JWT_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
# Время жизни access-токена (например: 15m, 1h). По умолчанию 15m.
ACCESS_TOKEN_TTL=15m
# Время жизни refresh-токена в днях. По умолчанию 30.
REFRESH_TOKEN_TTL_DAYS=30

# ── Первичный администратор (используется только seed-скриптом) ────
# В production ADMIN_PASSWORD ОБЯЗАТЕЛЕН (seed упадёт без него при создании админа).
# В development при пустом пароле seed сгенерирует временный и выведет в консоль.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# ── Хранилище файлов ───────────────────────────────────────────────
# Драйвер хранилища: local (по умолчанию). Заготовлено под s3/r2/minio.
FILE_STORAGE_DRIVER=local
# Каталог для загрузок (относительный или абсолютный). В Docker — volume.
UPLOADS_DIR=uploads
# Публичный путь, по которому отдаются файлы.
UPLOADS_PUBLIC_PATH=/uploads

# ── Rate limiting (план; см. MIGRATION_NOTES.md) ───────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ── Discord OAuth (опционально) ────────────────────────────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
