generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SonarAccountRole {
  CHAIRMAN
  OPERATOR

  @@map("sonar_account_role")
}

enum SonarCouncilDecisionStatus {
  DRAFT
  ADOPTED

  @@map("sonar_council_decision_status")
}

model SonarAccount {
  id               String           @id @default(cuid())
  login            String           @unique
  password_hash    String
  role             SonarAccountRole @default(OPERATOR)
  is_active        Boolean          @default(true)
  created_at       DateTime         @default(now())
  last_login_at    DateTime?
  password_changed DateTime         @default(now())
  sessions         SonarSession[]
  council_decisions SonarCouncilDecision[]

  @@map("sonar_accounts")
}

model SonarCouncilDecision {
  id          String                     @id @default(cuid())
  number      Int                        @unique @default(autoincrement())
  title       String
  body        String
  status      SonarCouncilDecisionStatus @default(DRAFT)
  author_id   String
  author      SonarAccount               @relation(fields: [author_id], references: [id])
  created_at  DateTime                   @default(now())
  adopted_at  DateTime?

  @@index([status])
  @@map("sonar_council_decisions")
}

model SonarSession {
  id           String       @id @default(cuid())
  token_hash   String       @unique
  account_id   String
  account      SonarAccount @relation(fields: [account_id], references: [id], onDelete: Cascade)
  created_at   DateTime     @default(now())
  last_seen_at DateTime     @default(now())
  expires_at   DateTime
  user_agent   String?
  ip_hash      String?

  @@index([account_id])
  @@index([expires_at])
  @@map("sonar_sessions")
}
