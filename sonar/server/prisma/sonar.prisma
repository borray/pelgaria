generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SonarAccountRole {
  CHAIRMAN
  OPERATOR

  @@map("sonar_account_role")
}

enum SonarCouncilDecisionStatus {
  DRAFT
  ADOPTED

  @@map("sonar_council_decision_status")
}

enum SonarPassportStatus {
  ACTIVE
  REVOKED

  @@map("sonar_passport_status")
}

model SonarAccount {
  id               String           @id @default(cuid())
  login            String           @unique
  password_hash    String
  role             SonarAccountRole @default(OPERATOR)
  is_active        Boolean          @default(true)
  created_at       DateTime         @default(now())
  last_login_at    DateTime?
  password_changed DateTime         @default(now())
  sessions         SonarSession[]
  council_decisions SonarCouncilDecision[]
  registered_players SonarPlayer[] @relation("PlayerRegisteredBy")
  issued_passports SonarPassport[] @relation("PassportIssuedBy")

  @@map("sonar_accounts")
}

model SonarPlayer {
  id              String        @id @default(cuid())
  nickname        String        @unique
  minecraft_uuid  String?       @unique
  note            String?
  registered_by_id String
  registered_by   SonarAccount  @relation("PlayerRegisteredBy", fields: [registered_by_id], references: [id])
  created_at      DateTime      @default(now())
  passport        SonarPassport?

  @@map("sonar_players")
}

model SonarPassport {
  id           String              @id @default(cuid())
  number       String              @unique
  player_id    String              @unique
  player       SonarPlayer         @relation(fields: [player_id], references: [id], onDelete: Cascade)
  issued_by_id String
  issued_by    SonarAccount        @relation("PassportIssuedBy", fields: [issued_by_id], references: [id])
  status       SonarPassportStatus @default(ACTIVE)
  issued_at    DateTime            @default(now())
  revoked_at   DateTime?

  @@index([status])
  @@map("sonar_passports")
}

model SonarCouncilDecision {
  id          String                     @id @default(cuid())
  number      Int                        @unique @default(autoincrement())
  title       String
  body        String
  status      SonarCouncilDecisionStatus @default(DRAFT)
  author_id   String
  author      SonarAccount               @relation(fields: [author_id], references: [id])
  created_at  DateTime                   @default(now())
  adopted_at  DateTime?

  @@index([status])
  @@map("sonar_council_decisions")
}

model SonarSession {
  id           String       @id @default(cuid())
  token_hash   String       @unique
  account_id   String
  account      SonarAccount @relation(fields: [account_id], references: [id], onDelete: Cascade)
  created_at   DateTime     @default(now())
  last_seen_at DateTime     @default(now())
  expires_at   DateTime
  user_agent   String?
  ip_hash      String?

  @@index([account_id])
  @@index([expires_at])
  @@map("sonar_sessions")
}
