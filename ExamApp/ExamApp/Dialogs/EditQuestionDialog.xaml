<Window x:Class="ExamApp.Dialogs.EditQuestionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ExamApp.Models"
        Title="Вопрос" Height="620" Width="680"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Question text -->
        <TextBlock Grid.Row="0" Text="Текст вопроса *" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox Grid.Row="1" Text="{Binding Question.Text, UpdateSourceTrigger=PropertyChanged}"
                 Padding="8,6" FontSize="13" TextWrapping="Wrap" AcceptsReturn="True"
                 Height="80" VerticalScrollBarVisibility="Auto"
                 Margin="0,0,0,12" BorderBrush="#BDBDBD" BorderThickness="1"/>

        <!-- Type, Topic, MaxScore -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Тип вопроса *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox SelectedValue="{Binding Question.Type}"
                          SelectedValuePath="Tag" Padding="8,6">
                    <ComboBoxItem Content="Одиночный выбор" Tag="{x:Static models:QuestionType.SingleChoice}"/>
                    <ComboBoxItem Content="Множественный выбор" Tag="{x:Static models:QuestionType.MultipleChoice}"/>
                    <ComboBoxItem Content="Развёрнутый ответ" Tag="{x:Static models:QuestionType.FreeForm}"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="Тема *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Topics}"
                          SelectedValue="{Binding Question.TopicId}"
                          SelectedValuePath="Id"
                          DisplayMemberPath="Name"
                          Padding="8,6"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Макс. баллов *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Question.MaxScore, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6" TextAlignment="Center" BorderBrush="#BDBDBD" BorderThickness="1"/>
            </StackPanel>
        </Grid>

        <!-- Answer options header -->
        <Grid Grid.Row="3" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Варианты ответа" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="+ Добавить вариант" Click="AddOption_Click"
                    Padding="10,6" Background="#1565C0" Foreground="White" BorderThickness="0"
                    FontSize="12"/>
        </Grid>

        <!-- Answer options list -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <ItemsControl ItemsSource="{Binding AnswerOptions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="4" Margin="0,0,0,6"
                                BorderBrush="#E0E0E0" BorderThickness="1">
                            <Grid Margin="8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsChecked="{Binding IsCorrect}"
                                          ToolTip="Правильный ответ" VerticalAlignment="Center"
                                          Margin="0,0,8,0"/>

                                <TextBox Grid.Column="1"
                                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" Background="Transparent"
                                         FontSize="12" VerticalAlignment="Center"
                                         Padding="4,2"/>

                                <TextBlock Grid.Column="2" Text="✓ правильный" FontSize="10"
                                           Foreground="#388E3C" VerticalAlignment="Center" Margin="8,0"
                                           Visibility="{Binding IsCorrect, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <Button Grid.Column="3" Content="✕" Tag="{Binding}"
                                        Click="RemoveOption_Click" Width="24" Height="24"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="#F44336" FontSize="12"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Width="90" Height="34" Margin="0,0,10,0"
                    Click="CancelButton_Click"
                    Background="White" BorderBrush="#BDBDBD" BorderThickness="1"/>
            <Button Content="Сохранить" Width="110" Height="34"
                    Click="SaveButton_Click"
                    Background="#1565C0" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
