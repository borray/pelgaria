<Window x:Class="ExamApp.Dialogs.EditQuestionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ExamApp.Models"
        xmlns:wm="clr-namespace:WpfMath.Controls;assembly=WpfMath"
        Title="Вопрос" Height="780" Width="780"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
            <StackPanel>

                <!-- Question text -->
                <TextBlock Text="Текст вопроса" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Question.Text, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6" FontSize="13" TextWrapping="Wrap" AcceptsReturn="True"
                         Height="70" VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,12" BorderBrush="#BDBDBD" BorderThickness="1"/>

                <!-- Formula (LaTeX) -->
                <TextBlock Text="Формула (LaTeX) — необязательно" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="FormulaBox"
                         Padding="8,6" FontSize="13" FontFamily="Consolas"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         Height="50" VerticalScrollBarVisibility="Auto"
                         BorderBrush="#BDBDBD" BorderThickness="1"/>
                <TextBlock Text="Пример:  \frac{a+b}{2} = \sqrt{x^2+1}"
                           FontSize="11" Foreground="#888" FontFamily="Consolas" Margin="2,3,0,4"/>

                <!-- Formula preview -->
                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4"
                        MinHeight="50" Padding="10,8" Margin="0,0,0,12">
                    <Grid>
                        <TextBlock Text="Предпросмотр формулы появится здесь" Foreground="#BBBBBB"
                                   FontSize="11" VerticalAlignment="Center"
                                   Visibility="{Binding Text, ElementName=FormulaBox, Converter={StaticResource HasContentToVisibilityConverter}, ConverterParameter=Invert}"/>
                        <wm:FormulaControl Formula="{Binding Text, ElementName=FormulaBox}"
                                           Scale="16" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Type, Topic, MaxScore -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Тип вопроса *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox SelectedValue="{Binding Question.Type}"
                                  SelectedValuePath="Tag" Padding="8,6">
                            <ComboBoxItem Content="Одиночный выбор" Tag="{x:Static models:QuestionType.SingleChoice}"/>
                            <ComboBoxItem Content="Множественный выбор" Tag="{x:Static models:QuestionType.MultipleChoice}"/>
                            <ComboBoxItem Content="Развёрнутый ответ" Tag="{x:Static models:QuestionType.FreeForm}"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Тема *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Topics}"
                                  SelectedValue="{Binding Question.TopicId}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="Name"
                                  Padding="8,6"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Макс. баллов *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Question.MaxScore, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" TextAlignment="Center" BorderBrush="#BDBDBD" BorderThickness="1"/>
                    </StackPanel>
                </Grid>

                <!-- Question images -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Картинки вопроса" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Добавить файл" Click="AddImageFile_Click"
                            Padding="10,5" Margin="0,0,6,0" Background="#1565C0" Foreground="White"
                            BorderThickness="0" FontSize="12"/>
                    <Button Grid.Column="2" Content="Вставить из буфера" Click="PasteImage_Click"
                            Padding="10,5" Background="#455A64" Foreground="White"
                            BorderThickness="0" FontSize="12"/>
                </Grid>

                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4"
                        MinHeight="70" Padding="8" Margin="0,0,0,12">
                    <Grid>
                        <TextBlock Text="Картинок нет" Foreground="#BBBBBB" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding QuestionImages.Count, Converter={StaticResource HasContentToVisibilityConverter}, ConverterParameter=Invert}"/>
                        <ItemsControl ItemsSource="{Binding QuestionImages}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="4" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4"
                                            Background="#FAFAFA" Padding="4">
                                        <StackPanel>
                                            <Image Source="{Binding ImageData, Converter={StaticResource BytesToImageConverter}}"
                                                   MaxHeight="90" MaxWidth="140" Stretch="Uniform"/>
                                            <Button Content="✕ удалить" Tag="{Binding}" Click="RemoveImage_Click"
                                                    Margin="0,4,0,0" Padding="4,2" FontSize="10"
                                                    Background="#FFEBEE" Foreground="#C62828" BorderThickness="0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- Answer options header -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Варианты ответа" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="+ Добавить вариант" Click="AddOption_Click"
                            Padding="10,6" Background="#1565C0" Foreground="White" BorderThickness="0"
                            FontSize="12"/>
                </Grid>

                <!-- Answer options list -->
                <ItemsControl ItemsSource="{Binding AnswerOptions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="4" Margin="0,0,0,8"
                                    BorderBrush="#E0E0E0" BorderThickness="1" Padding="8">
                                <StackPanel>
                                    <!-- Row 1: correct + text + remove -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsCorrect}"
                                                  Content="верный" ToolTip="Правильный ответ"
                                                  VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderBrush="#E0E0E0" BorderThickness="1"
                                                 FontSize="12" VerticalAlignment="Center" Padding="6,4"/>
                                        <Button Grid.Column="2" Content="✕" Tag="{Binding}"
                                                Click="RemoveOption_Click" Width="26" Height="26"
                                                Margin="6,0,0,0" Background="#FFEBEE"
                                                Foreground="#C62828" BorderThickness="0" FontSize="12"/>
                                    </Grid>

                                    <!-- Row 2: formula + preview -->
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding Formula, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderBrush="#E0E0E0" BorderThickness="1"
                                                 FontSize="11" FontFamily="Consolas" Padding="6,4" Margin="0,0,6,0"
                                                 ToolTip="Формула варианта (LaTeX), необязательно"/>
                                        <Border Grid.Column="1" Background="#FAFAFA" BorderBrush="#EEEEEE"
                                                BorderThickness="1" CornerRadius="3" Padding="6,2" MinHeight="28">
                                            <wm:FormulaControl Formula="{Binding Formula}" Scale="13"
                                                               HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>

                                    <!-- Row 3: option image -->
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0"
                                               Source="{Binding ImageData, Converter={StaticResource BytesToImageConverter}}"
                                               MaxHeight="60" MaxWidth="100" Stretch="Uniform"
                                               HorizontalAlignment="Left"
                                               Visibility="{Binding ImageData, Converter={StaticResource HasContentToVisibilityConverter}}"/>
                                        <TextBlock Grid.Column="1" Text="картинки нет" Foreground="#BBBBBB" FontSize="10"
                                                   VerticalAlignment="Center" Margin="2,0,0,0"
                                                   Visibility="{Binding ImageData, Converter={StaticResource HasContentToVisibilityConverter}, ConverterParameter=Invert}"/>
                                        <Button Grid.Column="2" Content="Картинка" Tag="{Binding}"
                                                Click="AddOptionImage_Click" Padding="8,3" FontSize="10"
                                                Background="#E3F2FD" Foreground="#1565C0" BorderThickness="0"
                                                Margin="0,0,4,0"/>
                                        <Button Grid.Column="3" Content="✕" Tag="{Binding}"
                                                Click="RemoveOptionImage_Click" Padding="6,3" FontSize="10"
                                                Background="#FFEBEE" Foreground="#C62828" BorderThickness="0"
                                                Visibility="{Binding ImageData, Converter={StaticResource HasContentToVisibilityConverter}}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Отмена" Width="90" Height="34" Margin="0,0,10,0"
                    Click="CancelButton_Click"
                    Background="White" BorderBrush="#BDBDBD" BorderThickness="1"/>
            <Button Content="Сохранить" Width="110" Height="34"
                    Click="SaveButton_Click"
                    Background="#1565C0" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
