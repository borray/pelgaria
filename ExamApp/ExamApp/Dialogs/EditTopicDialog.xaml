<Window x:Class="ExamApp.Dialogs.EditTopicDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Тема" Height="300" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Название *" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox Grid.Row="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 Padding="8,6" FontSize="13" Margin="0,0,0,12"
                 BorderBrush="#BDBDBD" BorderThickness="1"/>

        <TextBlock Grid.Row="2" Text="Описание" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox Grid.Row="3" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                 Padding="8,6" FontSize="13" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch"
                 BorderBrush="#BDBDBD" BorderThickness="1"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Width="90" Height="34" Margin="0,0,10,0"
                    Click="CancelButton_Click"
                    Background="White" BorderBrush="#BDBDBD" BorderThickness="1"/>
            <Button Content="Сохранить" Width="110" Height="34"
                    Click="SaveButton_Click"
                    Background="#1565C0" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
