<Window x:Class="ExamApp.Dialogs.EditExamDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="КИМ" Height="340" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Название КИМ *" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox Grid.Row="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                 Padding="8,6" FontSize="13" Margin="0,0,0,10" BorderBrush="#BDBDBD" BorderThickness="1"/>

        <TextBlock Grid.Row="2" Text="Описание / Инструкция" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox Grid.Row="3" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                 Padding="8,6" FontSize="13" TextWrapping="Wrap" AcceptsReturn="True"
                 Height="80" VerticalScrollBarVisibility="Auto"
                 Margin="0,0,0,10" BorderBrush="#BDBDBD" BorderThickness="1"/>

        <TextBlock Grid.Row="4" Text="Длительность (минут) *" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox Grid.Row="5" Text="{Binding DurationMinutes, UpdateSourceTrigger=PropertyChanged}"
                 Padding="8,6" FontSize="13" Width="120" HorizontalAlignment="Left"
                 BorderBrush="#BDBDBD" BorderThickness="1" VerticalAlignment="Top"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Width="90" Height="34" Margin="0,0,10,0"
                    Click="CancelButton_Click"
                    Background="White" BorderBrush="#BDBDBD" BorderThickness="1"/>
            <Button Content="Сохранить" Width="110" Height="34"
                    Click="SaveButton_Click"
                    Background="#1565C0" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
