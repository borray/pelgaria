<Window x:Class="ExamApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ExamApp.ViewModels"
        xmlns:views="clr-namespace:ExamApp.Views"
        Title="ЭкзаменПРО — Система контроля знаний"
        Height="768" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <!-- Nav button style: transparent, rounded, hover highlight -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="12,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A4D75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar navigation -->
        <Border Grid.Column="0" Background="#1E3A5F">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- App logo/title -->
                <Border Grid.Row="0" Background="#152B48" Padding="16,22">
                    <StackPanel>
                        <TextBlock Text="ЭкзаменПРО" Foreground="White" FontSize="19"
                                   FontWeight="Bold" TextAlignment="Center"/>
                        <TextBlock Text="Система тестирования" Foreground="#7FA8CC"
                                   FontSize="10" TextAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Navigation items -->
                <StackPanel Grid.Row="1" Margin="0,14,0,0">

                    <Button x:Name="NavQuestionBank" Click="NavButton_Click" Tag="QuestionBank"
                            Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="20" Height="20" Margin="0,0,12,0">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="White" Data="M18 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 4h5v8l-2.5-1.5L6 12V4z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Банк вопросов" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavExamFormation" Click="NavButton_Click" Tag="ExamFormation"
                            Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="20" Height="20" Margin="0,0,12,0">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="White" Data="M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Формирование КИМ" Foreground="White" FontSize="13"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavParticipants" Click="NavButton_Click" Tag="Participants"
                            Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="20" Height="20" Margin="0,0,12,0">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="White" Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Участники" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavPrint" Click="NavButton_Click" Tag="Print"
                            Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="20" Height="20" Margin="0,0,12,0">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="White" Data="M19 8H5c-1.66 0-3 1.34-3 3v6h4v4h12v-4h4v-6c0-1.66-1.34-3-3-3zm-3 11H8v-5h8v5zm3-7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-1-9H6v4h12V3z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Печать бланков" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Fill="#0D2035" Height="1" Margin="16,10"/>

                    <Button x:Name="NavResults" Click="NavButton_Click" Tag="Results"
                            Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="20" Height="20" Margin="0,0,12,0">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="White" Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Служебный раздел" Foreground="White" FontSize="13"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Version / update section pinned to bottom -->
                <Border Grid.Row="2" Background="#152B48" Padding="12,10">
                    <StackPanel>
                        <TextBlock x:Name="UpdateStatusText"
                                   Text=""
                                   Foreground="#7FA8CC" FontSize="10"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="0,0,0,6"/>
                        <Button x:Name="UpdateButton"
                                Content="⬇ Установить обновление"
                                Click="UpdateButton_Click"
                                Visibility="Collapsed"
                                Background="#FF8F00" Foreground="White"
                                BorderThickness="0" Padding="8,6"
                                FontSize="11" FontWeight="SemiBold"
                                Cursor="Hand"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Content area (switched by code-behind) -->
        <Grid Grid.Column="1">
            <views:QuestionBankView x:Name="QuestionBankView"/>
            <views:ExamFormationView x:Name="ExamFormationView" Visibility="Collapsed"/>
            <views:ParticipantsView x:Name="ParticipantsView" Visibility="Collapsed"/>
            <views:PrintView x:Name="PrintView" Visibility="Collapsed"/>
            <views:ResultsView x:Name="ResultsView" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
