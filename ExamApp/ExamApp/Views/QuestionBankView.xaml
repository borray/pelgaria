<UserControl x:Class="ExamApp.Views.QuestionBankView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded"
             Background="#F5F5F5">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Topics panel -->
        <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#1565C0" Padding="16,12">
                    <TextBlock Text="Темы / Дисциплины" Foreground="White" FontWeight="Bold" FontSize="14"/>
                </Border>

                <ListBox Grid.Row="1" ItemsSource="{Binding Topics}"
                         SelectedItem="{Binding SelectedTopic}"
                         BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1" Content="✎" Tag="{Binding}"
                                        Click="EditTopic_Click" Width="24" Height="24"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="#1565C0" ToolTip="Редактировать"
                                        Visibility="{Binding Id, Converter={StaticResource ZeroToVisibilityConverter}, ConverterParameter=Invert}"/>
                                <Button Grid.Column="2" Content="✕" Tag="{Binding}"
                                        Click="DeleteTopic_Click" Width="24" Height="24"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="#E53935" ToolTip="Удалить"
                                        Visibility="{Binding Id, Converter={StaticResource ZeroToVisibilityConverter}, ConverterParameter=Invert}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="Cursor" Value="Hand"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <Button Grid.Row="2" Content="+ Добавить тему" Click="AddTopic_Click"
                        Margin="12" Height="36" Background="#1565C0" Foreground="White"
                        BorderThickness="0" FontSize="13"/>
            </Grid>
        </Border>

        <!-- Right: Questions panel -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                    Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search box with placeholder -->
                    <Grid Grid.Column="0" MaxWidth="400" HorizontalAlignment="Left">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,6" FontSize="13"
                                 BorderBrush="#BDBDBD" BorderThickness="1"
                                 x:Name="SearchBox"/>
                        <TextBlock Text="Поиск по тексту вопроса..." Foreground="#AAAAAA"
                                   FontSize="13" Margin="12,7,0,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Button Grid.Column="1" Content="+ Добавить вопрос" Click="AddQuestion_Click"
                            Height="36" Padding="16,0" Background="#1565C0" Foreground="White"
                            BorderThickness="0" FontSize="13"/>
                </Grid>
            </Border>

            <!-- Questions list -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
                <ItemsControl ItemsSource="{Binding Questions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="6" Margin="0,0,0,8"
                                    BorderBrush="#E0E0E0" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Color="#CCCCCC" Opacity="0.3"/>
                                </Border.Effect>
                                <Grid Margin="16,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Text}"
                                               FontSize="13" TextWrapping="Wrap" Margin="0,0,16,4"/>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="✎" Tag="{Binding}" Click="EditQuestion_Click"
                                                Width="30" Height="30" Margin="4,0,0,0"
                                                Background="#E3F2FD" BorderThickness="0"
                                                Foreground="#1565C0" ToolTip="Редактировать"/>
                                        <Button Content="✕" Tag="{Binding}" Click="DeleteQuestion_Click"
                                                Width="30" Height="30" Margin="4,0,0,0"
                                                Background="#FFEBEE" BorderThickness="0"
                                                Foreground="#C62828" ToolTip="Удалить"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                Orientation="Horizontal">
                                        <Border Background="#E3F2FD" CornerRadius="10" Padding="8,3" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Type, Converter={StaticResource QuestionTypeToStringConverter}}"
                                                       FontSize="11" Foreground="#1565C0"/>
                                        </Border>
                                        <Border Background="#FFF3E0" CornerRadius="10" Padding="8,3" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Topic.Name}" FontSize="11" Foreground="#E65100"/>
                                        </Border>
                                        <Border Background="#F3E5F5" CornerRadius="10" Padding="8,3">
                                            <TextBlock FontSize="11" Foreground="#6A1B9A">
                                                <Run Text="Макс: "/>
                                                <Run Text="{Binding MaxScore}"/>
                                                <Run Text=" б."/>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
