<UserControl x:Class="ExamApp.Views.ExamFormationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded"
             Background="#F5F5F5">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- Exams list -->
        <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#1565C0" Padding="16,12">
                    <TextBlock Text="КИМы" Foreground="White" FontWeight="Bold" FontSize="14"/>
                </Border>

                <ListBox Grid.Row="1" ItemsSource="{Binding Exams}"
                         SelectedItem="{Binding SelectedExam}"
                         BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Title}"
                                           FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>

                                <Button Grid.Row="0" Grid.Column="1" Content="✎" Tag="{Binding}"
                                        Click="EditExam_Click" Width="24" Height="24"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="#1565C0" ToolTip="Редактировать"/>
                                <Button Grid.Row="0" Grid.Column="2" Content="✕" Tag="{Binding}"
                                        Click="DeleteExam_Click" Width="24" Height="24"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="#E53935" ToolTip="Удалить"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                           FontSize="10" Foreground="Gray">
                                    <Run Text="{Binding DurationMinutes}"/>
                                    <Run Text=" мин •"/>
                                    <Run Text="{Binding CreatedAt, StringFormat=dd.MM.yyyy}"/>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="Cursor" Value="Hand"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <Button Grid.Row="2" Content="+ Создать КИМ" Click="AddExam_Click"
                        Margin="12" Height="36" Background="#1565C0" Foreground="White"
                        BorderThickness="0" FontSize="13"/>
            </Grid>
        </Border>

        <!-- Selected exam questions -->
        <Grid Grid.Column="1" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" Padding="16,10" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="14" FontWeight="Bold" VerticalAlignment="Center">
                        <Run Text="Вопросы КИМ:"/>
                        <Run Text="{Binding SelectedExam.Title}" Foreground="#1565C0"/>
                    </TextBlock>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13">
                        <Run Text="Итого: " FontWeight="SemiBold"/>
                        <Run Text="{Binding TotalMaxScore}"/>
                        <Run Text=" б."/>
                    </TextBlock>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12">
                <ItemsControl ItemsSource="{Binding ExamQuestions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="6" Margin="0,0,0,6"
                                    BorderBrush="#E0E0E0" BorderThickness="1">
                                <Grid Margin="12,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Order}" FontWeight="Bold"
                                               Foreground="#1565C0" VerticalAlignment="Center" FontSize="14"/>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Question.Text}" FontSize="12"
                                                   TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Border Background="#E3F2FD" CornerRadius="8" Padding="6,2" Margin="0,0,4,0">
                                                <TextBlock Text="{Binding Question.Type, Converter={StaticResource QuestionTypeToStringConverter}}"
                                                           FontSize="10" Foreground="#1565C0"/>
                                            </Border>
                                            <Border Background="#F3E5F5" CornerRadius="8" Padding="6,2">
                                                <TextBlock FontSize="10" Foreground="#6A1B9A">
                                                    <Run Text="{Binding Question.MaxScore}"/>
                                                    <Run Text=" б."/>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Content="▲" Tag="{Binding}" Click="MoveUp_Click"
                                                Width="28" Height="28" Margin="2,0"
                                                Background="#F5F5F5" BorderThickness="0" FontSize="10"/>
                                        <Button Content="▼" Tag="{Binding}" Click="MoveDown_Click"
                                                Width="28" Height="28" Margin="2,0"
                                                Background="#F5F5F5" BorderThickness="0" FontSize="10"/>
                                        <Button Content="✕" Tag="{Binding}" Click="RemoveQuestion_Click"
                                                Width="28" Height="28" Margin="2,0"
                                                Background="#FFEBEE" BorderThickness="0"
                                                Foreground="#C62828" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Random add bar -->
            <Border Grid.Row="2" Background="White" Padding="12,8" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Добавить случайно:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="RandomTopicCombo" ItemsSource="{Binding Topics}"
                              DisplayMemberPath="Name" Width="160" Padding="6,4" Margin="0,0,8,0"
                              SelectedIndex="0"/>
                    <TextBox x:Name="RandomCountBox" Text="5" Width="50" Padding="6,4"
                             TextAlignment="Center" Margin="0,0,8,0"
                             BorderBrush="#BDBDBD" BorderThickness="1"/>
                    <TextBlock Text="вопр." VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Content="Добавить" Click="AddRandom_Click"
                            Height="32" Padding="12,0" Background="#FF8F00" Foreground="White"
                            BorderThickness="0" FontSize="12"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bank questions panel -->
        <Border Grid.Column="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#37474F" Padding="12,10">
                    <TextBlock Text="Банк вопросов" Foreground="White" FontWeight="Bold" FontSize="13"/>
                </Border>

                <Border Grid.Row="1" Padding="8,6" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                    <ComboBox ItemsSource="{Binding Topics}" DisplayMemberPath="Name"
                              SelectedItem="{Binding FilterTopic}" Padding="6,4" FontSize="12"/>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding BankQuestions}" Margin="6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FAFAFA" CornerRadius="4" Margin="0,0,0,4"
                                        BorderBrush="#E0E0E0" BorderThickness="1">
                                    <Grid Margin="8,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Text}" FontSize="11"
                                                       TextWrapping="Wrap" MaxHeight="40"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="10" Foreground="Gray" Margin="0,2,0,0">
                                                <Run Text="{Binding Type, Converter={StaticResource QuestionTypeToStringConverter}}"/>
                                                <Run Text=" •"/>
                                                <Run Text="{Binding MaxScore}"/>
                                                <Run Text="б."/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="+" Tag="{Binding}"
                                                Click="AddQuestionToExam_Click"
                                                Width="28" Height="28" FontSize="16"
                                                Background="#E8F5E9" BorderThickness="0"
                                                Foreground="#2E7D32" ToolTip="Добавить в КИМ"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
