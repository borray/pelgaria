<UserControl x:Class="ExamApp.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ExamApp.ViewModels"
             xmlns:models="clr-namespace:ExamApp.Models"
             Loaded="UserControl_Loaded"
             Background="#F5F5F5">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sessions list -->
        <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#1565C0" Padding="14,11">
                    <TextBlock Text="Сессии экзаменов" Foreground="White" FontWeight="Bold" FontSize="13"/>
                </Border>

                <ListBox Grid.Row="1" ItemsSource="{Binding Sessions}"
                         SelectedItem="{Binding SelectedSession}"
                         BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Exam.Title}" FontSize="12" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="10" Foreground="Gray">
                                        <Run Text="{Binding Date, StringFormat=dd.MM.yyyy}"/>
                                        <Run Text=" • "/>
                                        <Run Text="{Binding Location}"/>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" Content="✕" Tag="{Binding}"
                                        Click="DeleteSession_Click" Width="22" Height="22"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="#E53935" ToolTip="Удалить сессию"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,6"/>
                            <Setter Property="Cursor" Value="Hand"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- New session panel (hidden by default) -->
                <Border x:Name="NewSessionPanel" Grid.Row="2" Background="#FAFAFA"
                        BorderBrush="#E0E0E0" BorderThickness="0,1,0,0"
                        Padding="12" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Новая сессия" FontWeight="Bold" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding Exams}" DisplayMemberPath="Title"
                                  SelectedItem="{Binding NewSessionExam}"
                                  Padding="6,4" Margin="0,0,0,6" FontSize="12"/>
                        <DatePicker SelectedDate="{Binding NewSessionDate}"
                                    Margin="0,0,0,6" FontSize="12"/>
                        <TextBox Text="{Binding NewSessionLocation, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="6,4" FontSize="12" Margin="0,0,0,8"
                                 BorderBrush="#BDBDBD" BorderThickness="1">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Resources>
                                        <VisualBrush x:Key="WatermarkBrush" TileMode="None" Opacity="0.5" Stretch="None" AlignmentX="Left">
                                            <VisualBrush.Visual>
                                                <TextBlock Text="Место проведения..." Margin="4,0"/>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Style.Resources>
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background" Value="{StaticResource WatermarkBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsFocused" Value="True">
                                            <Setter Property="Background" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <!-- Participants for new session -->
                        <TextBlock Text="Участники:" FontWeight="SemiBold" Margin="0,0,0,4" FontSize="11"/>
                        <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SessionParticipants}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected}" Margin="2,2">
                                            <TextBlock FontSize="11">
                                                <Run Text="{Binding Participant.FullName}"/>
                                                <Run Text=" (" Foreground="Gray"/>
                                                <Run Text="{Binding Participant.GroupName}" Foreground="Gray"/>
                                                <Run Text=")" Foreground="Gray"/>
                                            </TextBlock>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Создать" Click="ConfirmNewSession_Click"
                                    Height="30" Padding="10,0" Background="#1565C0"
                                    Foreground="White" BorderThickness="0" FontSize="12"
                                    Margin="0,0,8,0"/>
                            <Button Content="Отмена" Click="CancelNewSession_Click"
                                    Height="30" Padding="10,0" Background="White"
                                    BorderBrush="#BDBDBD" BorderThickness="1" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button Grid.Row="3" Content="+ Новая сессия" Click="CreateSession_Click"
                        Margin="12" Height="34" Background="#1565C0" Foreground="White"
                        BorderThickness="0" FontSize="12"/>
            </Grid>
        </Border>

        <!-- Middle: Participants in session -->
        <Border Grid.Column="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#37474F" Padding="12,10">
                    <TextBlock Text="Участники сессии" Foreground="White" FontWeight="Bold" FontSize="13"/>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SessionResults}" Margin="8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Margin="0,0,0,4"
                                        BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FAFAFA"/>
                                            <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                        </Style>
                                    </Border.Style>
                                    <Grid Margin="8,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Participant.FullName}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="10" Foreground="Gray">
                                                <Run Text="{Binding Participant.GroupName}"/>
                                                <Run Text=" • "/>
                                                <Run Text="{Binding TotalScore}"/>
                                                <Run Text=" б."/>
                                                <Run Text="{Binding IsChecked, Converter={StaticResource CheckedStatusConverter}}"
                                                     Foreground="#2E7D32"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="✎" Tag="{Binding}"
                                                Click="SelectResult_Click"
                                                Width="26" Height="26" Margin="2,0"
                                                Background="#E3F2FD" BorderThickness="0"
                                                Foreground="#1565C0" ToolTip="Ввести ответы"/>
                                        <Button Grid.Column="2" Content="✕" Tag="{Binding}"
                                                Click="RemoveResult_Click"
                                                Width="26" Height="26" Margin="2,0"
                                                Background="#FFEBEE" BorderThickness="0"
                                                Foreground="#C62828" ToolTip="Удалить результат"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Summary table -->
                <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                    <Expander Header="Сводная таблица" Background="White">
                        <DataGrid ItemsSource="{Binding SummaryRows}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  MaxHeight="200" FontSize="11"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  BorderThickness="0"
                                  CanUserResizeRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Участник" Binding="{Binding ParticipantName}" Width="130"/>
                                <DataGridTextColumn Header="Балл" Binding="{Binding Score}" Width="45"/>
                                <DataGridTextColumn Header="Макс" Binding="{Binding MaxScore}" Width="45"/>
                                <DataGridTextColumn Header="%" Binding="{Binding Percent, Converter={StaticResource PercentageConverter}}" Width="55"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding CheckedStatus}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Expander>
                </Border>
            </Grid>
        </Border>

        <!-- Right: Answer entry panel -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" Padding="16,10"
                    BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock FontSize="14" FontWeight="Bold">
                            <Run Text="{Binding SelectedResult.Participant.FullName}"/>
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="Gray" Margin="0,2,0,0">
                            <Run Text="{Binding SelectedResult.Participant.GroupName}"/>
                            <Run Text=" • Балл: "/>
                            <Run Text="{Binding SelectedResult.TotalScore}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Проверено / Не проверено" Click="MarkChecked_Click"
                                Height="32" Padding="10,0" Margin="0,0,8,0"
                                Background="#E8F5E9" Foreground="#2E7D32" BorderThickness="0" FontSize="11"
                                Visibility="{Binding SelectedResult, Converter={StaticResource NullToVisibilityConverter}}"/>
                        <Button Content="Сохранить" Click="SaveAnswers_Click"
                                Height="32" Padding="16,0"
                                Background="#1565C0" Foreground="White" BorderThickness="0" FontSize="12"
                                Visibility="{Binding SelectedResult, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Scanned blank + answers -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
                <StackPanel>
                    <!-- Scanned blank -->
                    <Border Background="White" CornerRadius="6" Margin="0,0,0,12"
                            BorderBrush="#E0E0E0" BorderThickness="1"
                            Visibility="{Binding SelectedResult, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid Margin="14,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Скан бланка" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="{Binding ScannedBlankPath}" FontSize="10"
                                           Foreground="Gray" TextTrimming="CharacterEllipsis"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Обзор..." Click="BrowseBlank_Click"
                                    Height="30" Padding="10,0"
                                    Background="#EEEEEE" BorderThickness="0" FontSize="11"/>
                        </Grid>
                    </Border>

                    <!-- Answer rows -->
                    <ItemsControl ItemsSource="{Binding AnswerRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" CornerRadius="6" Margin="0,0,0,8"
                                        BorderBrush="#E0E0E0" BorderThickness="1">
                                    <StackPanel Margin="14,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding QuestionOrder}"
                                                       FontWeight="Bold" Foreground="#1565C0" FontSize="14"
                                                       VerticalAlignment="Top"/>
                                            <TextBlock Grid.Column="1" Text="{Binding QuestionText}"
                                                       FontSize="12" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Column="2" FontSize="11" Foreground="Gray"
                                                       VerticalAlignment="Top" Margin="8,0,0,0">
                                                <Run Text="макс."/>
                                                <Run Text="{Binding MaxScore}"/>
                                                <Run Text="б."/>
                                            </TextBlock>
                                        </Grid>

                                        <!-- Answer options for choice questions -->
                                        <ItemsControl ItemsSource="{Binding Options}" Margin="30,8,0,0"
                                                      Visibility="{Binding IsChoiceQuestion, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,3">
                                                        <TextBlock FontSize="12">
                                                            <Run Text="{Binding Letter}" FontWeight="Bold"
                                                                 Foreground="#1565C0"/>
                                                            <Run Text=") "/>
                                                            <Run Text="{Binding Text}"/>
                                                        </TextBlock>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- FreeForm: expert score entry -->
                                        <StackPanel Orientation="Horizontal" Margin="30,6,0,0"
                                                    Visibility="{Binding IsFreeForm, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="Балл эксперта:" FontSize="12" VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                            <TextBox Text="{Binding FreeFormScore, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="60" Padding="6,4" TextAlignment="Center"
                                                     BorderBrush="#BDBDBD" BorderThickness="1"
                                                     FontSize="12"/>
                                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
                                                       FontSize="11" Foreground="Gray">
                                                <Run Text="/ "/>
                                                <Run Text="{Binding MaxScore}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state -->
                    <TextBlock Text="Выберите участника слева для ввода ответов"
                               FontSize="14" Foreground="#9E9E9E"
                               HorizontalAlignment="Center" Margin="0,60,0,0"
                               Visibility="{Binding SelectedResult, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="White" Padding="16,8"
                    BorderBrush="#E0E0E0" BorderThickness="0,1,0,0"
                    Visibility="{Binding SelectedResult, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#555"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
