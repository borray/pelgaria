<UserControl x:Class="ExamApp.Views.PrintView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded"
             Background="#F5F5F5">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Settings panel -->
        <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
            <StackPanel Margin="20">
                <TextBlock Text="Параметры печати" FontSize="16" FontWeight="Bold"
                           Foreground="#1565C0" Margin="0,0,0,20"/>

                <TextBlock Text="Экзамен (КИМ) *" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding Exams}"
                          SelectedItem="{Binding SelectedExam}"
                          DisplayMemberPath="Title"
                          Padding="8,6" Margin="0,0,0,16" FontSize="13"/>

                <TextBlock Text="Дата экзамена *" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <DatePicker SelectedDate="{Binding ExamDate}"
                            Margin="0,0,0,20" FontSize="13"/>

                <Separator Margin="0,0,0,20"/>

                <!-- Action buttons -->
                <Button Content="Сгенерировать PDF" Click="GeneratePdf_Click"
                        Height="42" FontSize="14" FontWeight="SemiBold"
                        Background="#1565C0" Foreground="White" BorderThickness="0"
                        Margin="0,0,0,10"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>

                <Button Content="Открыть / Печать PDF" Click="OpenPdf_Click"
                        Height="38" FontSize="13"
                        Background="#FF8F00" Foreground="White" BorderThickness="0"
                        Visibility="{Binding HasGenerated, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#555"
                           Margin="0,12,0,0" TextWrapping="Wrap"/>

                <!-- Progress indicator -->
                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <Separator Margin="0,20,0,20"/>

                <TextBlock Text="Последний файл:" FontWeight="SemiBold" Margin="0,0,0,4"
                           Visibility="{Binding LastGeneratedPath, Converter={StaticResource NullToVisibilityConverter}}"/>
                <TextBlock Text="{Binding LastGeneratedPath}" FontSize="10" Foreground="#777"
                           TextWrapping="Wrap"
                           Visibility="{Binding LastGeneratedPath, Converter={StaticResource NullToVisibilityConverter}}"/>
            </StackPanel>
        </Border>

        <!-- Right: Participants selection -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                    Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Выберите участников" FontSize="14" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Выбрать всех" Click="SelectAll_Click"
                            Height="32" Padding="12,0" Margin="0,0,8,0"
                            Background="#E8F5E9" Foreground="#2E7D32" BorderThickness="0" FontSize="12"/>
                    <Button Grid.Column="2" Content="Снять всех" Click="DeselectAll_Click"
                            Height="32" Padding="12,0"
                            Background="#FFEBEE" Foreground="#C62828" BorderThickness="0" FontSize="12"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
                <ItemsControl ItemsSource="{Binding Participants}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="6" Margin="0,0,0,6"
                                    BorderBrush="#E0E0E0" BorderThickness="1">
                                <CheckBox IsChecked="{Binding IsSelected}" Margin="12,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Participant.FullName}"
                                                   FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock FontSize="11" Foreground="Gray">
                                            <Run Text="Группа:"/>
                                            <Run Text="{Binding Participant.GroupName}"/>
                                            <Run Text=" •"/>
                                            <Run Text="{Binding Participant.Email}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
