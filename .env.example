# Корневой пример окружения для запуска через docker compose.
# Скопируйте в .env: cp .env.example .env  и при необходимости измените значения.

# ── PostgreSQL ─────────────────────────────────────────────────────
POSTGRES_USER=sonar
POSTGRES_PASSWORD=sonar_local_password
POSTGRES_DB=sonar

# ── Backend (server) ───────────────────────────────────────────────
NODE_ENV=production
SERVER_PORT=3001
LOG_LEVEL=info
# Внутри compose сервер обращается к БД по имени сервиса "postgres".
DATABASE_URL=postgresql://sonar:sonar_local_password@postgres:5432/sonar?schema=public
# Адрес, по которому фронтенд доступен снаружи (для CORS).
CLIENT_URL=http://localhost:8080

# Секреты — обязательно замените в реальном развёртывании!
JWT_SECRET=change-me-access-secret-please
JWT_REFRESH_SECRET=change-me-refresh-secret-please
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Первичный администратор (для одноразового seed).
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Хранилище файлов.
FILE_STORAGE_DRIVER=local
UPLOADS_DIR=/app/uploads
UPLOADS_PUBLIC_PATH=/uploads

# Discord OAuth (опционально).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# Порт, на котором отдаётся фронтенд (nginx) наружу.
CLIENT_HTTP_PORT=8080
